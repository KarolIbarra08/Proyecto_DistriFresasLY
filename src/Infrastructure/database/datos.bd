

-- =========================================================
-- 2. CREACIÓN DE TABLAS (DDL)
-- =========================================================

-- Tabla: Roles
CREATE TABLE Roles (
    id_rol INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    descripcion VARCHAR(200)
);

-- Tabla: Usuarios
CREATE TABLE Usuarios (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    usuario VARCHAR(20) NOT NULL UNIQUE,
    contrasena VARCHAR(12) NOT NULL,
    estado BOOLEAN NOT NULL DEFAULT TRUE,
    id_rol INT NOT NULL,
    FOREIGN KEY (id_rol) REFERENCES Roles(id_rol)
);

-- Tabla: Clientes
CREATE TABLE Clientes (
    id_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    cedulaNIT VARCHAR(10) NOT NULL UNIQUE,
    telefono VARCHAR(10),
    direccion VARCHAR(80),
    tipo_de_negocio VARCHAR(50)
);

-- Tabla: Proveedores
CREATE TABLE Proveedores (
    id_proveedores INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    cedulaNIT VARCHAR(10) NOT NULL UNIQUE,
    telefono VARCHAR(10),
    direccion VARCHAR(80),
    nombre_empresa VARCHAR(100)
);

-- Tabla: ProductoFresa
CREATE TABLE ProductoFresa (
    id_producto_fresa INT AUTO_INCREMENT PRIMARY KEY,
    calidad VARCHAR(80) NOT NULL,
    peso DOUBLE(1, 8),
    descripcion VARCHAR(200)
);

-- Tabla: ProductoInsumo
CREATE TABLE ProductoInsumo (
    id_producto_insumo INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    tipo_insumo VARCHAR(50),
    unidad_medida VARCHAR(80),
    descripcion VARCHAR(200)
);

-- Tabla: Venta
CREATE TABLE Venta (
    id_venta INT AUTO_INCREMENT PRIMARY KEY,
    fecha_venta DATE NOT NULL,
    total DOUBLE(1, 8) NOT NULL,
    estado VARCHAR(50),
    id_cliente INT NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES Clientes(id_cliente)
);

-- Tabla: DetalleVenta
CREATE TABLE DetalleVenta (
    id_detalle_venta INT AUTO_INCREMENT PRIMARY KEY,
    cantidad INT NOT NULL,
    precio_unitario DOUBLE(1, 8) NOT NULL,
    subtotal DOUBLE(1, 8) NOT NULL,
    total_venta DOUBLE(1, 8) NOT NULL,
    id_producto INT NOT NULL,
    id_venta INT NOT NULL,
    FOREIGN KEY (id_venta) REFERENCES Venta(id_venta)
);

-- Tabla: PagoCliente
CREATE TABLE PagoCliente (
    id_pago_cliente INT AUTO_INCREMENT PRIMARY KEY,
    valor_total DOUBLE(1, 8) NOT NULL,
    medio_pago VARCHAR(50) NOT NULL,
    fecha_pago DATE NOT NULL,
    estado VARCHAR(50),
    id_cliente INT NOT NULL,
    id_venta INT NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES Clientes(id_cliente),
    FOREIGN KEY (id_venta) REFERENCES Venta(id_venta)
);

-- Tabla: Recibo
CREATE TABLE Recibo (
    id_recibo INT AUTO_INCREMENT PRIMARY KEY,
    fecha DATE NOT NULL,
    numero_recibo INT NOT NULL,
    total DOUBLE(1, 8) NOT NULL,
    id_venta INT NOT NULL,
    FOREIGN KEY (id_venta) REFERENCES Venta(id_venta)
);

-- Tabla: Pedidos
CREATE TABLE Pedidos (
    id_pedido INT AUTO_INCREMENT PRIMARY KEY,
    fecha_pedido DATE NOT NULL,
    estado BOOLEAN NOT NULL DEFAULT TRUE,
    total DOUBLE(1, 8) NOT NULL,
    id_proveedor INT NOT NULL,
    FOREIGN KEY (id_proveedor) REFERENCES Proveedores(id_proveedores)
);

-- Tabla: Detalle_Pedido
CREATE TABLE Detalle_Pedido (
    id_detalle_pedido INT AUTO_INCREMENT PRIMARY KEY,
    descripcion VARCHAR(200),
    cantidad INT NOT NULL,
    precio_unitario DOUBLE(1, 8) NOT NULL,
    id_pedido INT NOT NULL,
    FOREIGN KEY (id_pedido) REFERENCES Pedidos(id_pedido)
);

-- Tabla: Recepciones
CREATE TABLE Recepciones (
    id_recepcion INT AUTO_INCREMENT PRIMARY KEY,
    fecha_recepcion DATE NOT NULL,
    id_pedido INT NOT NULL,
    FOREIGN KEY (id_pedido) REFERENCES Pedidos(id_pedido)
);

-- Tabla: DetalleRecepcion
CREATE TABLE DetalleRecepcion (
    id_detalle_recepcion INT AUTO_INCREMENT PRIMARY KEY,
    cantidad INT NOT NULL,
    precio_unitario DOUBLE(1, 8) NOT NULL,
    fecha_ingreso DATE NOT NULL,
    id_recepcion INT NOT NULL,
    id_producto INT NOT NULL,
    FOREIGN KEY (id_recepcion) REFERENCES Recepciones(id_recepcion)
);

-- Tabla: PagoProveedores
CREATE TABLE PagoProveedores (
    id_pago_proveedores INT AUTO_INCREMENT PRIMARY KEY,
    valor_total DOUBLE(1, 8) NOT NULL,
    medio_pago VARCHAR(50) NOT NULL,
    fecha_pago DATE NOT NULL,
    estado VARCHAR(50),
    id_proveedor INT NOT NULL,
    id_pedido INT NOT NULL,
    FOREIGN KEY (id_proveedor) REFERENCES Proveedores(id_proveedores),
    FOREIGN KEY (id_pedido) REFERENCES Pedidos(id_pedido)
);

-- Tabla: Inventario
CREATE TABLE Inventario (
    id_inventario INT AUTO_INCREMENT PRIMARY KEY,
    cantidad_disponible INT NOT NULL,
    fecha_actualizacion DATE NOT NULL,
    id_producto INT NOT NULL
);

-- Tabla: ProductoDañado
CREATE TABLE ProductoDañado (
    id_producto_dañado INT AUTO_INCREMENT PRIMARY KEY,
    tipo_producto VARCHAR(50) NOT NULL,
    cantidad INT NOT NULL,
    identificacion VARCHAR(10),
    valor DOUBLE(1, 8) NOT NULL,
    fecha_producto_dañado DATE NOT NULL,
    motivo VARCHAR(200),
    id_producto INT NOT NULL
);


